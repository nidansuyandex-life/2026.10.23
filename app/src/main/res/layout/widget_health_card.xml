<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp"
    android:orientation="vertical">

    <!-- 顶部标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="日常 · 健康生活"
            android:textColor="#1B1F2A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_btn_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打卡"
            android:background="#1FBFA9"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="今日学习：0/10"
        android:textColor="#6b7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="本月支出：¥0"
        android:textColor="#FF6B5B"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#E6E9F1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="今日时间线"
            android:textColor="#1B1F2A"
            android:textSize="14sp"
            android:textStyle="bold" />
        <!-- 页码提示 -->
        <TextView
            android:id="@+id/widget_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/1"
            android:textColor="#8A90A2"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 待办列表容器：包含15个固定布局，动态填充 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
        <!-- 1~15 -->
        <LinearLayout android:id="@+id/widget_todo_item_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_1" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_2" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_3" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_4" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_5" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_6" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_7" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_8" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_8" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_9" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_9" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_9" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_10" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_10" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_10" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_11" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_11" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_11" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_12" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_12" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_12" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_13" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_13" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_13" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_14" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_14" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_14" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
        <LinearLayout android:id="@+id/widget_todo_item_15" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:visibility="gone"><TextView android:id="@+id/widget_todo_check_15" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/widget_checkbox_bg" android:gravity="center" android:textColor="#FFFFFF" android:textSize="12sp"/><TextView android:id="@+id/widget_todo_text_15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" /></LinearLayout>
    </LinearLayout>

    <!-- 底部翻页按钮 -->
    <LinearLayout android:id="@+id/widget_page_control" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
        <TextView android:id="@+id/widget_btn_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上一页" android:padding="8dp" android:textColor="#4f46e5" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text=" "/>
        <TextView android:id="@+id/widget_btn_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下一页" android:padding="8dp" android:textColor="#4f46e5" android:textSize="13sp" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
