<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80FFFFFF"
    android:padding="16dp"
    android:orientation="vertical">

    <!-- 顶部标题行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="日常 · 健康生活"
            android:textColor="#1B1F2A"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_btn_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打卡"
            android:background="#1FBFA9"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="今日学习：0/10"
        android:textColor="#6b7280"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="本月支出：¥0"
        android:textColor="#FF6B5B"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#E6E9F1"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="今日时间线"
        android:textColor="#1B1F2A"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- 固定 8 个条目，由代码动态填充文字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <!-- 条目 1 -->
        <LinearLayout android:id="@+id/widget_todo_item_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_1" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>
        
        <!-- 条目 2 -->
        <LinearLayout android:id="@+id/widget_todo_item_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_2" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>
        
        <!-- 条目 3 -->
        <LinearLayout android:id="@+id/widget_todo_item_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_3" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>

        <!-- 条目 4 -->
        <LinearLayout android:id="@+id/widget_todo_item_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_4" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>

        <!-- 条目 5 -->
        <LinearLayout android:id="@+id/widget_todo_item_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_5" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>

        <!-- 条目 6 -->
        <LinearLayout android:id="@+id/widget_todo_item_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_6" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>
        
        <!-- 条目 7 -->
        <LinearLayout android:id="@+id/widget_todo_item_7" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_7" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>

        <!-- 条目 8 -->
        <LinearLayout android:id="@+id/widget_todo_item_8" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
            <TextView android:id="@+id/widget_todo_check_8" android:layout_width="20dp" android:layout_height="20dp" android:text="☐" android:textSize="18sp" android:textColor="#1FBFA9" android:gravity="center"/>
            <TextView android:id="@+id/widget_todo_text_8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:textColor="#3A4152" android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
