<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:orientation="vertical">

    <!-- 顶栏：标题 + 打卡按钮 + 打开APP按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="日常 · 健康"
            android:textColor="#1B1F2A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_checkin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打卡"
            android:background="#1FBFA9"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginRight="8dp"/>
            
        <TextView
            android:id="@+id/widget_btn_open_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="打开APP"
            android:background="#4A9EFF"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 进度和支出 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="今日学习：0/10"
            android:textColor="#6b7280"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/widget_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本月支出：¥0"
            android:textColor="#FF6B5B"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- 时间线 1 -->
    <LinearLayout
        android:id="@+id/widget_item_1_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/widget_item_1_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_checkbox_bg" />
        <TextView
            android:id="@+id/widget_item_1_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="07:40 起床"
            android:textColor="#1B1F2A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 时间线 2 -->
    <LinearLayout
        android:id="@+id/widget_item_2_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/widget_item_2_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_checkbox_bg" />
        <TextView
            android:id="@+id/widget_item_2_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="07:45 护肤"
            android:textColor="#1B1F2A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 时间线 3 -->
    <LinearLayout
        android:id="@+id/widget_item_3_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/widget_item_3_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_checkbox_bg" />
        <TextView
            android:id="@+id/widget_item_3_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="07:50 早饭"
            android:textColor="#1B1F2A"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 时间线 4 -->
    <LinearLayout
        android:id="@+id/widget_item_4_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <ImageView
            android:id="@+id/widget_item_4_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_checkbox_bg" />
        <TextView
            android:id="@+id/widget_item_4_text"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="08:00 上班"
            android:textColor="#1B1F2A"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
